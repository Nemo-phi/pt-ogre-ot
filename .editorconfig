
# EditorConfig for Computational Optimal Transport
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4

# LaTeX and BibTeX
[*.{tex,bib}]
indent_size = 2
trim_trailing_whitespace = true

# YAML (GitHub Actions)
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefile
[Makefile]
indent_style = tab

# Jupyter notebooks
[*.ipynb]
indent_size = 2
